  have s0 : leavesOK ctxLit 10000000000 30 (leaves.drop 0) 450000000000 0 = true :=
    chunk_step (a := 0) (n := 100) group_00 s1
  simpa using s0

theorem leavesOK_full_K : leavesOK (mkCtx iLoNum 128) 10000000000 30 leaves 450000000000 0 = true := by
