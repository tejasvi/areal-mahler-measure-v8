/-!
# The upper certificate: polynomial facts, (C1) and the data conditions in the form of `UpCertHyp`

Polynomial facts forked from `Areal.Cert.CertData`; the budget from `Areal.Cert.TailSound2` (no `2s` term:
`∑ b_j deg Q_j < s`); the potential `-2 UR = ∫ log|x - y| G` in closed form (used by (C3)).
Generated by tools/gen_uglue.py.
-/

open Polynomial Set MeasureTheory

namespace Areal.UCert

open ArealUCore AuxCore AuxCommon

/-! ## Horner polynomials: degree and nonvanishing -/

theorem foldl_horner_shift (t : List ℤ) (p : ℤ[X]) :
    t.foldl (fun acc a => acc * X + Polynomial.C a) p =
      p * X ^ t.length + t.foldl (fun acc a => acc * X + Polynomial.C a) 0 := by
  induction t generalizing p with
  | nil => simp
  | cons b t ih =>
    simp only [List.foldl_cons, List.length_cons]
    rw [ih (p * X + Polynomial.C b), ih (0 * X + Polynomial.C b)]
    ring

theorem Qd_cons (b : ℤ) (t : List ℤ) : Qd (b :: t) = Polynomial.C b * X ^ t.length + Qd t := by
  unfold Qd
  rw [List.foldl_cons, foldl_horner_shift]
  ring

theorem degree_Qd_lt (t : List ℤ) : (Qd t).degree < t.length := by
  induction t with
  | nil => simp [Qd]
  | cons b t ih =>
    rw [Qd_cons, List.length_cons]
    calc (Polynomial.C b * X ^ t.length + Qd t).degree
        ≤ max (Polynomial.C b * X ^ t.length).degree (Qd t).degree := degree_add_le _ _
      _ < ((t.length + 1 : ℕ) : WithBot ℕ) := by
        apply max_lt
        · exact lt_of_le_of_lt (degree_C_mul_X_pow_le _ _) (by exact_mod_cast Nat.lt_succ_self _)
        · exact lt_trans ih (by exact_mod_cast Nat.lt_succ_self _)

theorem degree_Qd_lt_lead {b : ℤ} (hb : b ≠ 0) (t : List ℤ) :
    (Qd t).degree < (Polynomial.C b * X ^ t.length).degree := by
  rw [degree_C_mul_X_pow t.length hb]
  exact degree_Qd_lt t

theorem natDegree_Qd_cons {b : ℤ} (hb : b ≠ 0) (t : List ℤ) : (Qd (b :: t)).natDegree = t.length := by
  rw [Qd_cons, natDegree_add_eq_left_of_degree_lt (degree_Qd_lt_lead hb t),
    natDegree_C_mul_X_pow t.length b hb]

theorem Qd_cons_ne_zero {b : ℤ} (hb : b ≠ 0) (t : List ℤ) : Qd (b :: t) ≠ 0 := by
  intro h
  have hdeg := congrArg degree h
  rw [Qd_cons, degree_add_eq_left_of_degree_lt (degree_Qd_lt_lead hb t), degree_C_mul_X_pow t.length hb,
    degree_zero] at hdeg
  exact WithBot.coe_ne_bot hdeg

/-! ## The certificate polynomials -/

/-- Every certificate polynomial has a nonzero leading coefficient (kernel reduction on the data). -/
theorem polys_ok : ∀ j < 23, polys.getD j [] ≠ [] ∧ (polys.getD j []).headD 0 ≠ 0 := by
  decide +kernel

theorem natDegree_Qc (j : Fin JJ) : (Qc j).natDegree = (polys.getD j []).length - 1 := by
  obtain ⟨hne, hhead⟩ := polys_ok j j.isLt
  unfold Qc
  generalize polys.getD (↑j) [] = l at hne hhead ⊢
  cases l with
  | nil => exact absurd rfl hne
  | cons b t =>
    rw [List.headD_cons] at hhead
    rw [natDegree_Qd_cons hhead, List.length_cons, Nat.add_sub_cancel]

theorem Qc_ne_zero (j : Fin JJ) : Qc j ≠ 0 := by
  obtain ⟨hne, hhead⟩ := polys_ok j j.isLt
  unfold Qc
  generalize polys.getD (↑j) [] = l at hne hhead ⊢
  cases l with
  | nil => exact absurd rfl hne
  | cons b t =>
    rw [List.headD_cons] at hhead
    exact Qd_cons_ne_zero hhead t

theorem cR_eq_cj (j : Fin JJ) : cR j = cj j := rfl

theorem cR_nonneg (j : Fin JJ) : 0 ≤ cR j := by
  unfold cR
  exact div_nonneg (Nat.cast_nonneg _) (pow_nonneg (by norm_num) _)

theorem sum_cR_natDegree :
    ∑ j : Fin JJ, cR j * ((Qc j).natDegree : ℝ) =
      ∑ j ∈ Finset.range 23, cj j * (((polys.getD j []).length - 1 : ℕ) : ℝ) := by
  have h := Fin.sum_univ_eq_sum_range (fun j => cj j * (((polys.getD j []).length - 1 : ℕ) : ℝ)) JJ
  refine Eq.trans ?_ h
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [natDegree_Qc, cR_eq_cj]

theorem norm_eval_toC_Qc (j : Fin JJ) (x : ℝ) :
    ‖eval (x : ℂ) (toC (Qc j))‖ = |(QR (polys.getD j [])).eval x| := by
  unfold Qc
  exact toC_eval_eq (polys.getD j []) x


/-- `ℕ`-power with the instance of core Lean (as elaborated in `ArealUCore`), so that the restated checker terms below
are syntactically those of `ArealUCore` (no defeq check that could evaluate the certificate data). -/
local notation:75 a:76 " ^ᶜ " b:75 => @HPow.hPow ℕ ℕ ℕ (@instHPow ℕ ℕ (@instPowNat ℕ instNatPowNat)) a b

theorem cast_powC (a b : ℕ) : ((a ^ᶜ b : ℕ) : ℝ) = (a : ℝ) ^ b := Nat.cast_pow a b

/-! ## Constants of the budget -/

set_option maxRecDepth 20000 in
theorem cwSh_max : cwSh.foldl max 0 = 69 := by decide +kernel

set_option maxRecDepth 20000 in
theorem cwSh_le : ∀ j < 23, cwSh.getD j 0 ≤ 69 := by decide +kernel

/-- The left side of the budget check (common denominator `2^S sDen`). -/
def lhsV : ℕ :=
  (List.zip polys (List.zip cwNum cwSh)).foldl
    (fun acc x => acc + x.2.1 * (x.1.length - 1) * 2 ^ᶜ (cwSh.foldl max 0 - x.2.2) * sDen) 0

/-- The common denominator `2^S sDen`. -/
def kDenV : ℕ := 2 ^ᶜ (cwSh.foldl max 0) * sDen

/-- The right side `sNum 2^S`. -/
def rhsV : ℕ := sNum * 2 ^ᶜ (cwSh.foldl max 0)

theorem budgetOK_iff : budgetOK = true ↔ lhsV < rhsV := by
  simp only [budgetOK, lhsV, rhsV, decide_eq_true_eq]

theorem kDenV_pos : (0 : ℝ) < (kDenV : ℝ) := by
  have h : 0 < kDenV := Nat.mul_pos (Nat.two_pow_pos _) sDen_pos
  exact_mod_cast h

/-- The budget sum with the large constants as parameters (keeps the kernel away from `sDen`, `sNum`). -/
theorem lhs_gen (S sD : ℕ) :
    (List.zip polys (List.zip cwNum cwSh)).foldl
      (fun acc x => acc + x.2.1 * (x.1.length - 1) * 2 ^ᶜ (S - x.2.2) * sD) 0 =
    ∑ j ∈ Finset.range 23, cwNum.getD j 0 * ((polys.getD j []).length - 1) * 2 ^ᶜ (S - cwSh.getD j 0) * sD := by
  have hsum : ∀ (g : ℕ → ℕ), ((List.range 23).map g).sum = ∑ j ∈ Finset.range 23, g j :=
    fun g => list_sum_range g 23
  rw [polyZip_eq, foldl_add_eq_sum, zero_add, List.map_map, hsum]
  rfl

theorem lhsV_eq : lhsV =
    ∑ j ∈ Finset.range 23, cwNum.getD j 0 * ((polys.getD j []).length - 1) *
      2 ^ᶜ (cwSh.foldl max 0 - cwSh.getD j 0) * sDen :=
  lhs_gen _ _

/-- `lhs / (2^S sDen) = ∑ cⱼ dⱼ`. -/
theorem lhsV_div : (lhsV : ℝ) / (kDenV : ℝ) =
    ∑ j ∈ Finset.range 23, cj j * (((polys.getD j []).length - 1 : ℕ) : ℝ) := by
  have hD : (0 : ℝ) < (sDen : ℝ) := by exact_mod_cast sDen_pos
  have hle : ∀ j < 23, cwSh.getD j 0 ≤ cwSh.foldl max 0 := by
    rw [cwSh_max]
    exact cwSh_le
  rw [lhsV_eq, kDenV]
  generalize cwSh.foldl max 0 = S at hle ⊢
  generalize sDen = sD at hD ⊢
  have hS : (0 : ℝ) < 2 ^ S := by positivity
  push_cast [cast_powC]
  rw [div_eq_iff (mul_pos hS hD).ne', Finset.sum_mul]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  rw [pow_sub₀ (2 : ℝ) two_ne_zero (hle j (Finset.mem_range.mp hj))]
  unfold cj
  field_simp

theorem rhsV_div : (rhsV : ℝ) / (kDenV : ℝ) = sR := by
  have hD : (0 : ℝ) < (sDen : ℝ) := by exact_mod_cast sDen_pos
  rw [rhsV, kDenV, sR_eq]
  generalize cwSh.foldl max 0 = S
  generalize sNum = sN
  generalize sDen = sD at hD ⊢
  have hS : (0 : ℝ) < 2 ^ S := by positivity
  push_cast [cast_powC]
  field_simp

/-- **(C1), the degree budget.** -/
theorem budget_sound (h : budgetOK = true) :
    ∑ j ∈ Finset.range 23, cj j * (((polys.getD j []).length - 1 : ℕ) : ℝ) < sR := by
  rw [budgetOK_iff] at h
  rw [← lhsV_div, ← rhsV_div]
  exact div_lt_div_of_pos_right (by exact_mod_cast h) kDenV_pos



end Areal.UCert

