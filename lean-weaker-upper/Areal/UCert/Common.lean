/-! ## Data conditions of `UpCertHyp` -/

theorem eR_NN : eR NN = 20 := by unfold eR; rw [nodes_last]; norm_num

theorem integral_pwLin_eq_sR : ∫ y, pwLin NN eR GR y = sR := by
  rw [integral_pwLin eR_lt, sR_eq_trapezoid]

theorem GRh_eq (k : ℕ) : GRh k = GR k / 2 := by
  unfold GRh GR; rw [pow_succ]; ring

theorem slopeJump_GRh (i : ℕ) : slopeJump NN eR GRh i = slopeJump NN eR GR i / 2 := by
  unfold slopeJump slope
  simp only [GRh_eq]
  split_ifs <;> ring

/-- `-2 UR = U_μ`, the potential of `G dx` in closed form. -/
theorem neg_two_UR (x : ℝ) : -2 * UR x = ∫ y, Real.log |x - y| * pwLin NN eR GR y := by
  rw [integral_log_mul_pwLin eR_lt GR_zero GR_NN x, UR, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [CR, slopeJump_GRh]
  ring

theorem evalR_Qc (j : Fin JJ) (x : ℝ) : evalR (Qc j) x = (QR (polys.getD j [])).eval x := rfl

theorem C1_of_budget (h : budgetOK = true) : ∑ j, cR j * ((Qc j).natDegree : ℝ) < sR := by
  rw [sum_cR_natDegree]
  exact budget_sound h

end Areal.UCert

